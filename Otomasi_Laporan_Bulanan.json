    {
      "parameters": {
        "jsCode": "// Pembersihan Sheet 3: trimming whitespace + konversi angka\nconst rows = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nconst numFields = ['Penjualan Harian', 'Target Harian', 'Pendapatan Harian'];\nreturn rows.map(row => {\n  const clean = {};\n  for (const [k, v] of Object.entries(row)) {\n    clean[k.trim()] = typeof v === 'string' ? v.trim() : v;\n  }\n  for (const f of numFields) {\n    clean[f] = parseFloat(String(clean[f] ?? '').replace(/[^0-9.\\-]/g, '')) || 0;\n  }\n  return { json: clean };\n});"
      },
      "id": "n09",
      "name": "Code in JavaScript (Bersihkan Sheet 3)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
