      "parameters": {
        "jsCode": "// Tandai asal data: Sheet 1 atau Sheet 2\nconst idSheet1 = new Set($('Data Sheet 1').all().map(i => String(i.json['ID Laporan'] ?? '').trim()));\nreturn $input.all().map(item => {\n  const id = String(item.json['ID Laporan'] ?? '').trim();\n  return { json: { ...item.json, 'Sumber': idSheet1.has(id) ? 'Sheet 1' : 'Sheet 2' } };\n});"
      },
