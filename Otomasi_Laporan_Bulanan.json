    {
      "parameters": {
        "jsCode": "// Harmonisasi struktur Sheet 3 -> format Master Sheet (Sheet 1 & 2)\nconst inputData = $input.all();\nconst allRows = inputData.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\nconst transformedRows = allRows.map(row => {\n  // Gabungkan 'Kategori Produk' & 'Nama Produk' menjadi satu kolom 'Produk'\n  const produk = `${row['Kategori Produk'] || ''} ${row['Nama Produk'] || ''}`.trim();\n\n  return {\n    json: {\n      'ID Laporan': row['ID Laporan'] ? String(row['ID Laporan']) : '',\n      'Bulan': row['Bulan'] || '',\n      'Produk': produk,\n      'Wilayah': row['Wilayah'] || '-',\n      'Penjualan (Unit)': parseFloat(row['Penjualan Harian']) || 0,\n      'Target (Unit)': parseFloat(row['Target Harian']) || 0,\n      'Pendapatan (IDR)': parseFloat(row['Pendapatan Harian']) || 0,\n      'Status': row['Karyawan Penanggung Jawab']\n        ? (parseFloat(row['Penjualan Harian']) >= parseFloat(row['Target Harian']) ? 'Achieved' : 'Not Achieved')\n        : 'Pending',\n      'Keterangan': row['Catatan Tambahan'] || '',\n      'Tanggal Laporan': row['Tanggal'] || ''\n    }\n  };\n});\n\nreturn transformedRows;"
      },
