    {
      "parameters": {
        "jsCode": "// Generate Laporan: statistik bulan berjalan\nconst allInputs = $input.all();\nconst allRows = allInputs.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\n// Identifikasi bulan & tahun saat ini\nconst now = new Date();\nconst currentMonthName = now.toLocaleString('id-ID', { month: 'long' });\nconst currentYear = now.getFullYear();\n\n// Filter data bulan berjalan\nconst monthlyData = allRows.filter(row =>\n  String(row['Bulan'] || '').trim().toLowerCase() === currentMonthName.toLowerCase()\n);\n\n// Agregasi metrik kunci\nconst totalPenjualan = monthlyData.reduce((sum, r) => sum + (parseFloat(r['Penjualan (Unit)']) || 0), 0);\nconst totalPendapatan = monthlyData.reduce((sum, r) => sum + (parseFloat(r['Pendapatan (IDR)']) || 0), 0);\nconst totalTarget = monthlyData.reduce((sum, r) => sum + (parseFloat(r['Target (Unit)']) || 0), 0);\nconst jumlah = monthlyData.length;\nconst achieved = monthlyData.filter(r => r['Status'] === 'Achieved').length;\n\nconst laporan = {\n  'Bulan': currentMonthName,\n  'Tahun': currentYear,\n  'Jumlah Transaksi': jumlah,\n  'Total Penjualan (Unit)': totalPenjualan,\n  'Total Pendapatan (IDR)': totalPendapatan,\n  'Rata-rata Penjualan (Unit)': jumlah ? Math.round((totalPenjualan / jumlah) * 100) / 100 : 0,\n  'Rata-rata Pendapatan (IDR)': jumlah ? Math.round(totalPendapatan / jumlah) : 0,\n  'Pencapaian Target (%)': totalTarget ? Math.round((totalPenjualan / totalTarget) * 10000) / 100 : 0,\n  'Transaksi Achieved': achieved,\n  'Tanggal Generate': now.toISOString().slice(0, 10)\n};\n\nreturn [{ json: laporan }];"
      },
