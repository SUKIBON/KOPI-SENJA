    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet total = 0, positif = 0, negatif = 0, netral = 0;\n\nfor (const row of rows) {\n  total++;\n  const raw = row.json['Sentiment'] ?? row.json['sentiment'] ?? row.json['Sentimen'] ?? row.json['sentimen'] ?? '';\n  const s = String(raw).toLowerCase();\n\n  if (s.includes('positive')) positif++;\n  else if (s.includes('negative')) negatif++;\n  else if (s.includes('neutral')) netral++;\n}\n\nreturn [{\n  json: {\n    total_tweets: total,\n    sentimen_positif: positif,\n    sentimen_negatif: negatif,\n    sentimen_netral: netral,\n  },\n}];"
      },
