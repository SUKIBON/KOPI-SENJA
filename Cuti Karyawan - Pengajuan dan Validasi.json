    {
      "parameters": {
        "jsCode": "// ============================================================\n// ALTERNATIF Node \"Validasi Cuti\"\n// Mode  : Run Once for Each Item\n// Bahasa: JavaScript\n// Luxon : DateTime sudah tersedia bawaan di n8n\n// ============================================================\n\n// GANTI dengan URL Production webhook \"Approval Handler\"\nconst WEBHOOK_URL = 'https://n8n-elqfjut8ir1g.eu1.sumopod.my.id/webhook-test/approval-handler';\n\n// 1. Data karyawan dari Google Sheets (item saat ini)\nconst emp = $json;\n\n// 2. Data dari form (nama node harus sama persis dengan di workflow Anda)\nconst form = $('On form submission').first().json;\n\n// 3. Hitung durasi dengan Luxon (selisih hari + 1 agar inklusif)\nconst start = DateTime.fromISO(form['Tanggal Mulai']);\nconst end = DateTime.fromISO(form['Tanggal Selesai']);\nconst tanggalValid = start.isValid && end.isValid && end >= start;\nconst durationRequested = tanggalValid ? Math.round(end.diff(start, 'days').days) + 1 : 0;\n\n// 4. Validasi saldo\nconst karyawanAda = Boolean(emp.Email);\nconst currentBalance = Number(emp.Saldo_Cuti) || 0;\nconst isApprovedSystem = karyawanAda && tanggalValid && currentBalance >= durationRequested;\n\n// 5. Alasan penolakan sistem (dipakai di email penolakan)\nlet rejectReason = '';\nif (!karyawanAda) rejectReason = 'Email tidak terdaftar di database karyawan.';\nelse if (!tanggalValid) rejectReason = 'Tanggal selesai harus sama dengan atau setelah tanggal mulai.';\nelse if (!isApprovedSystem) rejectReason = `Saldo cuti tidak mencukupi. Sisa ${currentBalance} hari, diajukan ${durationRequested} hari.`;\n\n// 6. ID unik dan timestamp\nconst requestId = 'REQ-' + DateTime.now().toFormat('yyyyLLddHHmmss');\nconst submittedAt = DateTime.now().toFormat('yyyy-LL-dd HH:mm:ss');\n\n// 7. Link tombol email manajer\nconst buildUrl = (status) =>\n  `${WEBHOOK_URL}?status=${status}&id=${encodeURIComponent(requestId)}` +\n  `&email=${encodeURIComponent(form['Email Karyawan'])}&days=${durationRequested}`;\n\n// 8. Output (nama field sama dengan node berikutnya)\nreturn {\n  json: {\n    ...form,\n    requestId,\n    submittedAt,\n    durationRequested,\n    currentBalance,\n    namaKaryawan: emp.Nama || form['Email Karyawan'],\n    managerEmail: emp.Manager_Email || '',\n    isApprovedSystem,\n    rejectReason,\n    approveUrl: buildUrl('approved'),\n    rejectUrl: buildUrl('rejected')\n  }\n};"
      },
